public class solution {
  public int[] findbuildings(int[] heights) {
    int n  = heights.length;
    Stack<integer> stack = new Stack<>():

    for (int i = 0; i < heights.length; i++) {
        while (!stack.isEmpty() && heights[stack.peak()] <= heights[i]) {
          stack.pop();
        }
        stack.push(i);
    }

    int[] result = new int[stack.size()];
    int i = 0;
    for (int num : stack) {
      result[i] = num;
      i++;
    }
    return result;
  }
}

#This is a monotonic stack approach which is a better solution than the bruteforce 2 loop approach. 
